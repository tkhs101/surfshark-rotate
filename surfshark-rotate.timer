[Unit]
Description=每 5 分钟轮换一次 Surfshark 出口 IP

[Timer]
Unit=surfshark-rotate.service

# 开机 3 分钟后第一轮，给网络和隧道留出建立时间
OnBootSec=3min

# 「本服务上次激活 5 分钟后」再次触发。
# 选 OnUnitActiveSec 而不是 OnCalendar：上一轮慢了几秒不会让节奏累积漂移。
OnUnitActiveSec=10min

# 关机/休眠期间错过的触发，开机后补跑一次，不会因为停机就永久丢失轮换
Persistent=true

# 允许 systemd 合并触发点，误差不超过 15 秒。
# 不设的话默认误差 1 分钟，轮换间隔会在 5~6 分钟之间浮动。
AccuracySec=15s

[Install]
WantedBy=timers.target